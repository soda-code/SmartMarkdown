<Window x:Class="SmartMarkDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Untitled-1 - SmartMarkDown" Height="800" Width="1200"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#333333"/>
        <SolidColorBrush x:Key="TextMuted" Color="#717171"/>
        <SolidColorBrush x:Key="ControlBg" Color="#F8F8F8"/>
        <SolidColorBrush x:Key="ControlHover" Color="#E8E8E8"/>

        <SolidColorBrush x:Key="MenuPopupBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuPopupBorder" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="MenuHighlight" Color="#E8E8E8"/>

        <SolidColorBrush x:Key="StatusBarBg" Color="#007ACC"/>
        <SolidColorBrush x:Key="StatusBarFg" Color="#FFFFFF"/>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 紧凑的菜单项样式 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="TemplateRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="3" Margin="1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CheckMark" Grid.Column="0" Text="✔" Foreground="{DynamicResource TextPrimary}" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextMuted}" Margin="20,0,4,0" VerticalAlignment="Center"/>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,0" Placement="Bottom" PopupAnimation="Fade">
                                    <Border x:Name="SubMenuBorder" Background="{DynamicResource MenuPopupBg}" BorderBrush="{DynamicResource MenuPopupBorder}" BorderThickness="1" CornerRadius="4" MinWidth="180" Padding="3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Color="Black" Direction="270" Opacity="0.3" ShadowDepth="3"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="TemplateRoot" Property="Background" Value="{DynamicResource MenuHighlight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AiPillButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernIconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="true">
                <Border HorizontalAlignment="Right" Width="18">
                    <Path Data="M 0 0 L 3.5 3.5 L 7 0" HorizontalAlignment="Center" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="true">
                            <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ModernComboBoxToggleButton}"/>
                            <ContentPresenter Content="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" IsHitTestVisible="false" Margin="8,0,20,0" VerticalAlignment="Center"/>
                            <Popup AllowsTransparency="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,2,0,0" Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="{DynamicResource MenuPopupBg}" BorderBrush="{DynamicResource MenuPopupBorder}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MaxHeight="260" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="Black" Direction="270" Opacity="0.2" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained" Margin="2"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- 顶部区域：使用 StackPanel 垂直排列菜单和快捷工具栏，确保绝不拥挤裁切 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Vertical">
                <!-- 第一行：主菜单栏 -->
                <Menu VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <MenuItem Header="文件 (_F)">
                        <MenuItem Header="新建文件 (_N)" Click="BtnNew_Click" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="打开文件 (_O)..." Click="BtnOpen_Click" InputGestureText="Ctrl+O"/>
                        <Separator/>
                        <MenuItem Header="保存 (_S)" Click="BtnSave_Click" InputGestureText="Ctrl+S"/>
                        <MenuItem Header="另存为 (_A)..." Click="BtnSaveAs_Click" InputGestureText="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="导出为独立 HTML..." Click="BtnExportHtml_Click"/>
                        <Separator/>
                        <MenuItem Header="退出 (_X)" Click="MenuExit_Click"/>
                    </MenuItem>

                    <MenuItem Header="编辑 (_E)">
                        <MenuItem Header="撤销 (Undo)" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="重做 (Redo)" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="剪切 (Cut)" InputGestureText="Ctrl+X"/>
                        <MenuItem Header="复制 (Copy)" InputGestureText="Ctrl+C"/>
                        <MenuItem Header="粘贴 (Paste)" InputGestureText="Ctrl+V"/>
                        <Separator/>
                        <MenuItem Click="ToolClear_Click" Header="清空文档"/>
                    </MenuItem>

                    <MenuItem Header="段落 (_P)">
                        <MenuItem Header="一级标题 (Heading 1)" Click="ToolInsertH2_Click" InputGestureText="Ctrl+1"/>
                        <MenuItem Header="二级标题 (Heading 2)" Click="ToolInsertH2_Click" InputGestureText="Ctrl+2"/>
                        <MenuItem Header="三级标题 (Heading 3)" Click="ToolInsertH2_Click" InputGestureText="Ctrl+3"/>
                        <Separator/>
                        <MenuItem Header="正文 (Paragraph)" InputGestureText="Ctrl+0"/>
                        <Separator/>
                        <MenuItem Header="无序列表 (Bullet List)"/>
                        <MenuItem Header="有序列表 (Ordered List)"/>
                        <MenuItem Header="任务列表 (Task List)"/>
                        <Separator/>
                        <MenuItem Header="引用块 (Blockquote)" InputGestureText="Ctrl+Shift+Q"/>
                    </MenuItem>

                    <MenuItem Header="格式 (_Format)">
                        <MenuItem Header="粗体 (**Bold**)" Click="ToolInsertBold_Click" InputGestureText="Ctrl+B"/>
                        <MenuItem Header="斜体 (*Italic*)" Click="ToolInsertItalic_Click" InputGestureText="Ctrl+I"/>
                        <MenuItem Header="下划线 (Underline)" InputGestureText="Ctrl+U"/>
                        <MenuItem Header="删除线 (Strikethrough)" InputGestureText="Alt+Shift+5"/>
                        <MenuItem Header="高亮 (Highlight)"/>
                        <Separator/>
                        <MenuItem Header="代码块 (Code Span)" Click="ToolInsertCode_Click" InputGestureText="Ctrl+Shift+K"/>
                        <MenuItem Header="数学公式 (Math Block)" Click="ToolInsertMath_Click"/>
                    </MenuItem>

                    <MenuItem Header="插入 (_Insert)">
                        <MenuItem Header="图片..." />
                        <MenuItem Header="超链接..." Click="ToolInsertLink_Click" InputGestureText="Ctrl+K"/>
                        <MenuItem Header="代码块" Click="ToolInsertCode_Click"/>
                        <Separator/>
                        <MenuItem Header="表格模板" Click="ToolInsertTable_Click"/>
                        <MenuItem Header="流程图 (Mermaid)" Click="ToolInsertMermaid_Click"/>
                        <Separator/>
                        <MenuItem Header="水平分割线 (Horizontal Line)"/>
                    </MenuItem>

                    <MenuItem Header="✨ AI 工具箱 (_A)">
                        <MenuItem Click="AiPolish_Click" Header="✨ 一键润色与纠错"/>
                        <MenuItem Click="AiSummarize_Click" Header="📝 提取核心要点摘要"/>
                        <MenuItem Click="AiContinue_Click" Header="✍️ 承接上下文智能续写"/>
                        <MenuItem Click="AiTranslate_Click" Header="🌐 翻译为英文"/>
                        <Separator/>
                        <MenuItem Click="BtnConfigKey_Click" Header="⚙️ 配置当前模型 API Key..."/>
                    </MenuItem>

                    <MenuItem Header="视图 (_V)">
                        <MenuItem Click="BtnToggleView_Click" Header="仅阅读模式" IsCheckable="True" x:Name="MenuOnlyPreview"/>
                        <MenuItem Click="BtnToggleOutline_Click" Header="显示大纲面板" IsCheckable="True" IsChecked="True" x:Name="MenuToggleOutline"/>
                        <MenuItem Click="BtnToggleTheme_Click" Header="VS Code 暗黑模式 (Dark+)" IsCheckable="True" x:Name="MenuDarkMode"/>
                        <Separator/>
                        <MenuItem Header="阅读版心宽度...">
                            <MenuItem Click="MenuWidthCustom_Click" Header="设置自定义宽度 (px 或 %)..."/>
                            <Separator/>
                            <MenuItem Click="MenuWidthStandard_Click" Header="标准 (900px)" x:Name="MenuWidthStandard"/>
                            <MenuItem Click="MenuWidthFull_Click" Header="全宽 (100%)" x:Name="MenuWidthFull"/>
                            <MenuItem Click="MenuWidthNarrow_Click" Header="窄屏 (700px)" x:Name="MenuWidthNarrow"/>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="帮助 (_H)">
                        <MenuItem Header="版本: v1.1.0" IsEnabled="False"/>
                        <MenuItem Click="MenuOpenRepo_Click" Header="开源地址 (GitHub)..."/>
                    </MenuItem>
                </Menu>

                <!-- 第二行：快捷工具栏与 AI 按钮，支持 WrapPanel 自适应折行 -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnNew_Click" Content="➕ 新建" Height="26" Margin="0,2,4,2" Style="{StaticResource ModernButton}" ToolTip="新建文件 (Ctrl+N)"/>
                    <Button Click="BtnOpen_Click" Content="📂 打开" Height="26" Margin="0,2,6,2" Style="{StaticResource ModernButton}" ToolTip="打开文件 (Ctrl+O)"/>

                    <Rectangle Fill="{DynamicResource BorderBrush}" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" Width="1"/>

                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,5,0" Text="AI 模型:" VerticalAlignment="Center"/>
                    <ComboBox Height="26" Margin="0,2" SelectionChanged="CmbModels_SelectionChanged" Style="{StaticResource ModernComboBox}" VerticalAlignment="Center" Width="130" x:Name="CmbModels">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Click="BtnConfigKey_Click" Content="⚙️" Margin="3,2,0,2" Style="{StaticResource ModernIconButton}" ToolTip="配置当前模型 API Key"/>

                    <Rectangle Fill="{DynamicResource BorderBrush}" Height="14" Margin="8,0" VerticalAlignment="Center" Width="1"/>

                    <Button Click="AiPolish_Click" Content="✨ 润色" Height="26" Margin="0,2" Style="{StaticResource AiPillButton}"/>
                    <Button Click="AiSummarize_Click" Content="📝 摘要" Height="26" Margin="2" Style="{StaticResource AiPillButton}"/>
                    <Button Click="AiContinue_Click" Content="✍️ 续写" Height="26" Margin="2,2,0,2" Style="{StaticResource AiPillButton}"/>

                    <Rectangle Fill="{DynamicResource BorderBrush}" Height="14" Margin="8,0" VerticalAlignment="Center" Width="1"/>

                    <Button Click="BtnToggleView_Click" Content="👁️ 预览" Height="26" Margin="0,2" Style="{StaticResource ModernButton}" x:Name="BtnToggleView"/>
                    <Button Click="BtnToggleTheme_Click" Content="🌙" Margin="2,2,0,2" Style="{StaticResource ModernIconButton}" ToolTip="切换 VS Code 主题" x:Name="BtnThemeToggle"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 主体区域 -->
        <Grid Background="{DynamicResource BgBrush}" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" x:Name="ColOutline"/>
                <ColumnDefinition Width="4" x:Name="ColOutlineSplitter"/>
                <ColumnDefinition Width="1*" x:Name="ColEditor"/>
                <ColumnDefinition Width="4" x:Name="ColSplitter"/>
                <ColumnDefinition Width="1*" x:Name="ColPreview"/>
            </Grid.ColumnDefinitions>

            <!-- 大纲面板 -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Grid.Row="0" Margin="12,0,0,0" Text="📑 文档大纲" VerticalAlignment="Center"/>
                    <ListBox Background="Transparent" BorderThickness="0" DisplayMemberPath="DisplayText" FontSize="12" Foreground="{DynamicResource TextPrimary}" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListOutline_SelectionChanged" x:Name="ListOutline">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" CornerRadius="3" Margin="4,2" Padding="{TemplateBinding Padding}" x:Name="Bd">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ControlHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" TargetName="Bd" Value="#094771"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Background="{DynamicResource BorderBrush}" Cursor="SizeWE" Grid.Column="1" HorizontalAlignment="Stretch" x:Name="OutlineSplitter"/>

            <!-- Markdown 编辑器 -->
            <TextBox AcceptsReturn="True" AcceptsTab="True" Background="{DynamicResource BgBrush}" BorderThickness="0" FontFamily="Cascadia Code, Consolas, Fira Code, Courier New" FontSize="14" Foreground="{DynamicResource TextPrimary}" Grid.Column="2" Padding="16" TextChanged="TxtMarkdown_TextChanged" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" x:Name="TxtMarkdown"/>

            <GridSplitter Background="{DynamicResource BorderBrush}" Cursor="SizeWE" Grid.Column="3" HorizontalAlignment="Stretch" x:Name="MainSplitter"/>

            <!-- 网页预览区 -->
            <wv2:WebView2 Grid.Column="4" x:Name="BrowserPreview" />
        </Grid>

        <Grid Background="{DynamicResource StatusBarBg}" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="12" Foreground="{DynamicResource StatusBarFg}" Margin="0,0,10,0" Text="Markdown"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource StatusBarFg}" Margin="0,0,10,0" Text="UTF-8"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource StatusBarFg}" Text="0 字符 | 0 词" x:Name="StatusWordCount"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" Orientation="Horizontal" Visibility="Collapsed" x:Name="PanelAiLoading">
                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,6,0" VerticalAlignment="Center" Width="60"/>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusBarFg}" Text="AI 运行中..."/>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource StatusBarFg}" Margin="0,0,10,0" Text="模型: DeepSeek" x:Name="StatusCurrentModel"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource StatusBarFg}" Text="就绪" x:Name="StatusMessage"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>