<Window x:Class="SmartMarkDown.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lobster AI Config" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- 圆角输入框样式 -->
        <Style x:Key="LobsterPasswordBox" TargetType="PasswordBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="White" BorderBrush="#E05D5D" BorderThickness="2" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 龙虾风圆角按钮 -->
        <Style x:Key="LobsterButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 龙虾主题标题 -->
        <Border Grid.Row="0" Background="#E05D5D" CornerRadius="8" Padding="10" Margin="0,0,0,15">
            <TextBlock x:Name="TxtProviderName" FontSize="16" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
        </Border>

        <!-- 模型版本选择 -->
        <TextBlock Grid.Row="1" Text="模型版本 (Model Selection)" FontSize="12" Foreground="#666" Margin="0,0,0,5" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbSubModels" Grid.Row="2" Height="35" Margin="0,0,0,15" Padding="5,0" 
                  BorderBrush="#E05D5D" Background="White" VerticalContentAlignment="Center"/>

        <!-- 密钥输入区域 -->
        <TextBlock Grid.Row="3" Text="安全密钥 (API Secret)" FontSize="12" Foreground="#666" Margin="0,0,0,5" FontWeight="SemiBold"/>
        <PasswordBox x:Name="TxtBoxKey" Grid.Row="4" Height="40" FontSize="14" 
                     Style="{StaticResource LobsterPasswordBox}"/>

        <!-- 底部大按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="立即保存 (Save)" Width="120" Height="40" Click="BtnConfirm_Click" IsDefault="True"
                    Background="#E05D5D" Foreground="White" FontWeight="Bold" Cursor="Hand" 
                    Style="{StaticResource LobsterButton}"/>
        </StackPanel>
    </Grid>
</Window>